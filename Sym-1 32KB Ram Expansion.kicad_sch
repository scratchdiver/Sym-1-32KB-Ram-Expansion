	(text "Take PHI2 from finger U and R/W from finger V. Fingers Y and W are duplicates; leave them open."
		(exclude_from_sim no)
		(at 25.4 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5b77f124-83e0-4eae-b18a-ef876282fc2a")
	)
	(text "Finger Z is the motherboard RAM R/W strobe. Finger 16 is the active-low $1800 select. Leave both open."
		(exclude_from_sim no)
		(at 25.4 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5ea389ae-302c-4295-a845-a01cbc80bf67")
	)
	(text "U2D  /WE = NAND(PHI2, not R/W)"
		(exclude_from_sim no)
		(at 195.86 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7051d2d7-527c-43a4-ad46-c1608c4c1d08")
	)
	(text "AB15 low enables U1. /OE is low only during a read while PHI2 is high."
		(exclude_from_sim no)
		(at 25.4 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8913dd51-aa73-4d4f-b2a7-6d907d51e60c")
	)
	(text "Pull every onboard 2114 before reset. U1 is then the only RAM, at $0000-$7FFF."
		(exclude_from_sim no)
		(at 25.4 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "942ed33e-21ef-4904-8012-90f5e4ef2bdc")
	)
	(text "U2A  inverts R/W"
		(exclude_from_sim no)
		(at 195.86 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "aad882d4-9e92-46b3-9c02-58dd8f51f712")
	)
	(text "AS6C62256-55PCN and CY62256NLL-70PXC are the same DIP-28 pinout. Use a 74HCT00, not a 74HC00."
		(exclude_from_sim no)
		(at 25.4 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c3b321b5-2b8e-46a0-acec-f63d0dd3acda")
	)
	(text "C1 at U1.   C2 at U2.   C3 is the bulk bypass at J1 +5V."
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "da6c086b-02a2-4fcb-a78e-8cda2a08dd7a")
	)
